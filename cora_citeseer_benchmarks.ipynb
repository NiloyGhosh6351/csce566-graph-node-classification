   "source": [
    "metrics = [\"Accuracy\", \"ROC AUC\"]\n",
    "summary = results.groupby([\"Dataset\", \"Model\"])[metrics].agg([\"mean\", \"std\"])\n",
    "display(summary.round(4))\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(9, 3.6), layout=\"constrained\")\n",
    "colors = [\"#196b89\", \"#aa4d26\"]\n",
    "for ax, metric in zip(axes, metrics):\n",
    "    mean = summary[(metric, \"mean\")].unstack()\n",
    "    std = summary[(metric, \"std\")].unstack()\n",
    "    mean.plot.bar(ax=ax, yerr=std, color=colors, capsize=4, rot=0, legend=False)\n",
    "    ax.set(title=metric, xlabel=\"\", ylabel=\"Test score\", ylim=(0, 1))\n",
    "    ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "    ax.grid(axis=\"y\", alpha=0.25)\n",
    "    ax.set_axisbelow(True)\n",
    "handles, labels = axes[0].get_legend_handles_labels()\n",
    "axes[1].legend(handles, labels, frameon=False, loc=\"lower right\")\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "31009332",
   "metadata": {},
   "source": [
    "Both models use the citation graph, while the GCN also uses word features. This comparison measures the two complete benchmarks and does not isolate the effect of graph convolution from the effect of the additional features. The splits are repeated random splits of the raw LINQS datasets, so the scores are specific to this protocol.\n"
   ]
  }
